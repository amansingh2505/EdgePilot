{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "declaration": false,
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "plugins", "demo-test-data", "workflows", "**/*.js"]
}
