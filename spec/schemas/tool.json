{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Definition",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "examples": { "type": "array" }
  },
  "required": ["id", "name"]
}
